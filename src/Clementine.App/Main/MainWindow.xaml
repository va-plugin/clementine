<Window x:Class="Clementine.App.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clementine" Width="1000" Height="680" MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
  <Window.Resources>
    <Style x:Key="TileHeader" TargetType="Button" BasedOn="{StaticResource Shell.ButtonBase}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,12,12,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Shell.Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource Shell.CardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Width" Value="214" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Shell.CardHover}" />
          <Setter Property="BorderBrush" Value="#59FF8A1F" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <!-- ===== Main column ===== -->
    <Grid Margin="28,20,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="HeaderLogo" Width="30" Height="30" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="Clementine" Style="{StaticResource Shell.Title}" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="HelpButton" Style="{StaticResource Shell.SubtleButton}" ToolTip="How to use Clementine" Margin="0,0,4,0" AutomationProperties.Name="Help">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE897;" Style="{StaticResource Shell.Glyph}" FontSize="14" Margin="0,0,8,0" />
              <TextBlock Text="Help" />
            </StackPanel>
          </Button>
          <Button x:Name="SettingsButton" Style="{StaticResource Shell.SubtleButton}" ToolTip="Settings" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource Shell.Glyph}" FontSize="14" Margin="0,0,8,0" />
              <TextBlock Text="Settings" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Empty state: big drop zone -->
      <Border x:Name="DropZone" Grid.Row="1" CornerRadius="14" Background="#08FFFFFF">
        <Grid>
          <Rectangle x:Name="DropZoneOutline" RadiusX="14" RadiusY="14" Stroke="#3DFFFFFF" StrokeThickness="1.5" StrokeDashArray="6 5" SnapsToDevicePixels="True" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
            <Image x:Name="DropLogo" Width="88" Height="88" HorizontalAlignment="Center" />
            <TextBlock Text="Drop files here" Style="{StaticResource Shell.Title}" FontSize="24" HorizontalAlignment="Center" Margin="0,18,0,6" />
            <TextBlock x:Name="DropHint" Style="{StaticResource Shell.Caption}" FontSize="13.5" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="or hold Shift while dragging files anywhere" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
              <Button x:Name="BrowseButton" Style="{StaticResource Shell.PrimaryButton}" Content="Browse…" MinWidth="110" Margin="0,0,10,0" />
              <Button x:Name="BrowseFolderButton" Content="Choose a folder…" />
            </StackPanel>
            <Border Background="#0AFFFFFF" CornerRadius="10" Padding="18,12" Margin="0,34,0,0" HorizontalAlignment="Center">
              <StackPanel x:Name="ShortcutRows" />
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Files chosen: summary, tabs, tiles -->
      <Grid x:Name="FilesView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Shell.CardBorder}" Padding="12,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="SelectionIcon" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SelectionTitle" Style="{StaticResource Shell.Heading}" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="SelectionDetails" Style="{StaticResource Shell.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="AddMoreButton" Content="Add files…" Margin="0,0,8,0" />
              <Button x:Name="ClearSelectionButton" Style="{StaticResource Shell.SubtleButton}" Content="Clear" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,18,0,10">
          <RadioButton x:Name="ConvertTab" Style="{StaticResource Shell.Tab}" GroupName="Mode" IsChecked="True" AutomationProperties.Name="Convert" />
          <RadioButton x:Name="ToolsTab" Style="{StaticResource Shell.Tab}" GroupName="Mode" AutomationProperties.Name="Tools" />
          <RadioButton x:Name="ActionsTab" Style="{StaticResource Shell.Tab}" GroupName="Mode" AutomationProperties.Name="Actions" />
        </StackPanel>

        <!-- FFmpeg missing: shown on tabs where most groups are greyed out for that reason -->
        <Border x:Name="FfmpegBanner" Grid.Row="2" Visibility="Collapsed" Background="#1FFFC048" BorderBrush="#4DFFC048" BorderThickness="1"
                CornerRadius="8" Padding="12,7,8,7" Margin="0,2,0,10" AutomationProperties.LiveSetting="Polite">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button x:Name="GetFfmpegButton" Style="{StaticResource Shell.PrimaryButton}" Content="Get FFmpeg" Margin="0,0,6,0" Padding="12,4"
                      ToolTip="Opens the FFmpeg download page in your browser" />
              <Button x:Name="ChooseFfmpegButton" Content="Choose…" Padding="12,4" ToolTip="Point Clementine at an ffmpeg.exe you already have"
                      AutomationProperties.Name="Choose ffmpeg.exe" />
            </StackPanel>
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Shell.Glyph}" FontSize="15" Foreground="{StaticResource Shell.Warning}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="FfmpegBannerText" Text="FFmpeg isn't installed — video and audio need it." FontSize="13" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="3" x:Name="TilesScroller" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,4,-12,0">
          <StackPanel>
            <WrapPanel x:Name="Tiles" />
            <StackPanel x:Name="NoOperations" Margin="4,30,24,0" Visibility="Collapsed">
              <TextBlock x:Name="NoOperationsTitle" Style="{StaticResource Shell.Heading}" Text="Nothing here for these files" />
              <TextBlock x:Name="NoOperationsText" Style="{StaticResource Shell.Caption}" Margin="0,6,0,0" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Column="1" Width="1" Background="{StaticResource Shell.Divider}" />

    <!-- ===== Recent jobs ===== -->
    <Grid Grid.Column="2" Background="#0DFFFFFF">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="20,26,14,10">
        <TextBlock Text="Recent jobs" Style="{StaticResource Shell.Heading}" VerticalAlignment="Center" />
        <Button x:Name="ClearJobsButton" Style="{StaticResource Shell.LinkButton}" Content="Clear finished" HorizontalAlignment="Right"
                FontWeight="Normal" FontSize="12" />
      </Grid>
      <ListBox x:Name="JobsList" Grid.Row="1" Margin="10,0,10,12" VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid x:Name="Row" Background="Transparent" ToolTip="{Binding Tooltip}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Operation}" Style="{StaticResource Shell.Caption}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Minimum="0" Maximum="1"
                             Visibility="{Binding ProgressVisibility}" Margin="0,6,0,2" Height="3" />
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <Button Style="{StaticResource Shell.IconButton}" Content="&#xE838;" ToolTip="Show in folder" Visibility="{Binding RevealVisibility}"
                        Tag="reveal" Click="OnJobButton" />
                <Button Style="{StaticResource Shell.IconButton}" Content="&#xE711;" ToolTip="Cancel" Visibility="{Binding CancelVisibility}"
                        Tag="cancel" Click="OnJobButton" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="NoJobs" Grid.Row="1" Margin="22,8,22,0" Visibility="Collapsed">
        <TextBlock Style="{StaticResource Shell.Caption}" Text="Nothing yet. Converted files show up here, and are saved next to the originals." />
      </StackPanel>
    </Grid>

    <!-- Drag-over highlight for the whole window -->
    <Border x:Name="DragOverlay" Grid.ColumnSpan="3" Background="#1FFF8A1F" BorderBrush="{StaticResource Clementine.Accent}" BorderThickness="2"
            CornerRadius="0" IsHitTestVisible="False" Visibility="Collapsed">
      <Border Background="{StaticResource Shell.Popup}" CornerRadius="10" Padding="22,14" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="{StaticResource Clementine.Stroke}" BorderThickness="1">
        <TextBlock Text="Drop to choose what to do" Style="{StaticResource Shell.Heading}" />
      </Border>
    </Border>
  </Grid>
</Window>
