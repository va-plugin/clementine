<Window x:Class="Clementine.App.Dialogs.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How to use Clementine" Width="640" Height="660" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="34,26,34,28">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Image x:Name="Logo" Width="40" Height="40" Margin="0,0,14,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="How to use Clementine" Style="{StaticResource Shell.Title}" />
          <TextBlock Text="Convert files by dragging them — no windows to open." Style="{StaticResource Shell.Caption}" FontSize="13" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="Steps" Margin="0,18,0,0" />
      <Border Style="{StaticResource Shell.CardBorder}" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Text="Good to know" Style="{StaticResource Shell.Heading}" FontSize="14" Margin="0,0,0,8" />
          <TextBlock x:Name="Tips" Style="{StaticResource Shell.Body}" Foreground="{StaticResource Clementine.TextSecondary}" LineHeight="21" />
        </StackPanel>
      </Border>
      <Button x:Name="CloseButton" Style="{StaticResource Shell.PrimaryButton}" Content="Got it" HorizontalAlignment="Right" MinWidth="100" Margin="0,20,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
