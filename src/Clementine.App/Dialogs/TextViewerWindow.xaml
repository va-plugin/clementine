<Window x:Class="Clementine.App.Dialogs.TextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clementine" Width="680" Height="500" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24,18,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="HeadingText" Style="{StaticResource Shell.Title}" FontSize="19" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="SubheadingText" Style="{StaticResource Shell.Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </StackPanel>
    <TextBox x:Name="Body" Grid.Row="1" Margin="0,14,0,14" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             VerticalContentAlignment="Top" Padding="12,10" FontFamily="{StaticResource Shell.MonoFont}" FontSize="12.5"
             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <CheckBox x:Name="WrapToggle" Content="Wrap lines" Style="{StaticResource Shell.Toggle}" />
      <Button x:Name="SaveButton" Grid.Column="2" Content="Save as…" MinWidth="92" Margin="0,0,8,0" />
      <Button x:Name="CopyButton" Grid.Column="3" Style="{StaticResource Shell.PrimaryButton}" Content="Copy" MinWidth="92" />
    </Grid>
  </Grid>
</Window>
