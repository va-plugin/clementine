<Window x:Class="Clementine.App.Dialogs.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clementine" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
  <StackPanel Margin="26,22,26,20">
    <StackPanel Orientation="Horizontal">
      <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Shell.ErrorSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
        <TextBlock Text="&#xE783;" Style="{StaticResource Shell.Glyph}" FontSize="17" Foreground="{StaticResource Clementine.Error}" />
      </Border>
      <StackPanel VerticalAlignment="Center" MaxWidth="400">
        <TextBlock x:Name="HeadingText" Text="Something went wrong" Style="{StaticResource Shell.Heading}" FontSize="16" />
        <TextBlock x:Name="MessageText" Style="{StaticResource Shell.Body}" Foreground="{StaticResource Clementine.TextSecondary}" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>
    <TextBox x:Name="DetailsBox" Margin="0,16,0,0" Height="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             FontFamily="{StaticResource Shell.MonoFont}" FontSize="11.5" VerticalContentAlignment="Top"
             HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />
    <Grid Margin="0,18,0,0">
      <Button x:Name="DetailsButton" Style="{StaticResource Shell.LinkButton}" Content="Show details" HorizontalAlignment="Left" FontWeight="Normal" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CopyButton" Content="Copy details" Margin="0,0,8,0" />
        <Button x:Name="CloseButton" Style="{StaticResource Shell.PrimaryButton}" Content="OK" MinWidth="84" IsDefault="True" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
