<UserControl x:Class="Clementine.App.Toasts.ToastCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource Shell.ToastWidth}">
  <UserControl.Resources>
    <Style x:Key="ToastButton" TargetType="Button" BasedOn="{StaticResource Shell.ButtonBase}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="11,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="ToastPrimaryButton" TargetType="Button" BasedOn="{StaticResource Shell.PrimaryButton}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </UserControl.Resources>
  <UserControl.RenderTransform>
    <TranslateTransform x:Name="Slide" />
  </UserControl.RenderTransform>

  <Border x:Name="Card" Style="{StaticResource Shell.Popover}" Margin="0,8,0,0" Padding="14,12,8,12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Icon with status badge -->
      <Grid Width="40" Height="40" VerticalAlignment="Top" Margin="0,1,12,0">
        <Border x:Name="GlyphTile" CornerRadius="9" Background="{StaticResource Shell.AccentSoft}">
          <TextBlock x:Name="KindGlyph" Style="{StaticResource Shell.Glyph}" FontSize="18" Foreground="{StaticResource Clementine.AccentLight}" />
        </Border>
        <Image x:Name="FileIcon" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border x:Name="Badge" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-4,-3" BorderThickness="2" BorderBrush="#FF211E1C" Visibility="Collapsed">
          <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Shell.Glyph}" FontSize="9" FontWeight="Bold" Foreground="#FF14110E" />
        </Border>
      </Grid>

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Clementine.Text}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Shell.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

        <StackPanel x:Name="ProgressPanel" Margin="0,9,6,0" Visibility="Collapsed">
          <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" />
          <TextBlock x:Name="StatusText" Style="{StaticResource Shell.Caption}" FontSize="11.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Style="{StaticResource Shell.Body}" FontSize="12.5" Margin="0,7,6,0" Visibility="Collapsed" />

        <Border x:Name="TextPreviewBox" Background="{StaticResource Shell.Input}" BorderBrush="{StaticResource Shell.CardStroke}" BorderThickness="1"
                CornerRadius="6" Padding="10,7" Margin="0,9,6,0" Visibility="Collapsed">
          <TextBlock x:Name="TextPreview" FontFamily="{StaticResource Shell.MonoFont}" FontSize="11.5" Foreground="{StaticResource Clementine.Text}"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </Border>

        <StackPanel x:Name="WarningsPanel" Margin="0,8,6,0" Visibility="Collapsed" />

        <TextBlock x:Name="DoneText" Style="{StaticResource Shell.Caption}" FontSize="11.5" Margin="0,4,0,0" Visibility="Collapsed" />

        <WrapPanel x:Name="ButtonsPanel" Margin="0,10,0,0" Visibility="Collapsed">
          <Button x:Name="ShowInFolderButton" Style="{StaticResource ToastPrimaryButton}" Content="Show in folder" />
          <Button x:Name="OpenButton" Style="{StaticResource ToastButton}" Content="Open" />
          <Button x:Name="CopyButton" Style="{StaticResource ToastButton}" Content="Copy" />
          <Button x:Name="ViewButton" Style="{StaticResource ToastButton}" Content="View" />
          <Button x:Name="DetailsButton" Style="{StaticResource ToastButton}" Content="Details" />
          <Button x:Name="ActionButton" Style="{StaticResource ToastButton}" Content="Action" />
        </WrapPanel>
      </StackPanel>

      <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource Shell.IconButton}" Content="&#xE8BB;" FontSize="10"
              VerticalAlignment="Top" Margin="2,-4,0,0" ToolTip="Dismiss" />
    </Grid>
  </Border>
</UserControl>
