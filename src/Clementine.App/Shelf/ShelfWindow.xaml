<Window x:Class="Clementine.App.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clementine shelf"
        Width="356" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowDrop="True">
  <Border x:Name="Card" Style="{StaticResource Shell.Popover}" Margin="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="Header" Background="Transparent" Margin="16,14,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE718;" Style="{StaticResource Shell.Glyph}" FontSize="15" Foreground="{StaticResource Clementine.AccentLight}" Margin="0,0,10,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Shelf" Style="{StaticResource Shell.Heading}" />
          <TextBlock x:Name="CountText" Style="{StaticResource Shell.Caption}" FontSize="11.5" />
        </StackPanel>
        <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource Shell.SubtleButton}" Content="Clear" FontSize="12" MinHeight="28" Margin="0,0,2,0" VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource Shell.IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Hide the shelf" />
      </Grid>

      <Border Grid.Row="1" Height="1" Background="{StaticResource Shell.Divider}" />

      <Grid Grid.Row="2">
        <ListBox x:Name="List" Margin="8,8,8,10" MaxHeight="420" SelectionMode="Extended" VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid x:Name="Row" Background="Transparent" ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding FolderShort}" Style="{StaticResource Shell.Caption}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel x:Name="RowButtons" Grid.Column="2" Orientation="Horizontal" Visibility="Hidden" Margin="6,0,0,0">
                  <Button Style="{StaticResource Shell.IconButton}" Content="&#xE838;" ToolTip="Show in folder" Tag="reveal" Click="OnRowButton" Width="26" Height="26" />
                  <Button Style="{StaticResource Shell.IconButton}" Content="&#xE711;" ToolTip="Remove from the shelf" Tag="remove" Click="OnRowButton" Width="26" Height="26" />
                </StackPanel>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                  <Setter TargetName="RowButtons" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="EmptyState" Margin="24,26,24,30" HorizontalAlignment="Center" Visibility="Collapsed">
          <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource Shell.AccentSoft}" HorizontalAlignment="Center">
            <TextBlock Text="&#xE718;" Style="{StaticResource Shell.Glyph}" FontSize="20" Foreground="{StaticResource Clementine.AccentLight}" />
          </Border>
          <TextBlock Text="Nothing pinned yet" Style="{StaticResource Shell.Heading}" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
          <TextBlock Style="{StaticResource Shell.Caption}" TextAlignment="Center"
                     Text="Drop files here, or Alt+Shift-drag them anywhere and choose Shelf. Drag them out again whenever you need them." />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
