<Window x:Class="Clementine.App.Preferences.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clementine settings" Width="900" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <Border Background="#0DFFFFFF" BorderBrush="{StaticResource Shell.Divider}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,22,14,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
          <Image x:Name="Logo" Width="28" Height="28" Margin="0,0,10,0" />
          <TextBlock Text="Settings" Style="{StaticResource Shell.Title}" FontSize="19" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel x:Name="Nav" />
      </DockPanel>
    </Border>

    <!-- Page -->
    <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel x:Name="PageHost" Margin="36,26,36,30" MaxWidth="760" HorizontalAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
