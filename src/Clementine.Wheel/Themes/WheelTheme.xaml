<!--
  Wheel-specific look, built on the shared Clementine palette (Colors.xaml, merged below).
  WheelPalette reads these keys once, freezes them and falls back to built-in values if a key is missing.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Clementine.Wheel;component/Themes/Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Glass disc behind the centre and the inner ring -->
  <SolidColorBrush x:Key="Wheel.Disc" Color="{StaticResource Clementine.GlassColor}" />
  <SolidColorBrush x:Key="Wheel.DiscEdge" Color="#30FFFFFF" />
  <LinearGradientBrush x:Key="Wheel.DiscSheen" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Offset="0" Color="#16FFFFFF" />
    <GradientStop Offset="0.45" Color="#00FFFFFF" />
  </LinearGradientBrush>
  <Color x:Key="Wheel.ShadowColor">#80000000</Color>

  <!-- Inner-ring segments -->
  <SolidColorBrush x:Key="Wheel.Segment" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Wheel.SegmentDisabled" Color="#07FFFFFF" />
  <SolidColorBrush x:Key="Wheel.SegmentExpanded" Color="#3DFF8A1F" />
  <SolidColorBrush x:Key="Wheel.SegmentHoverDisabled" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="Wheel.VariantHint" Color="#4DFFFFFF" />

  <!-- Outer-ring variants -->
  <SolidColorBrush x:Key="Wheel.Variant" Color="#F5231F1C" />
  <SolidColorBrush x:Key="Wheel.VariantEdge" Color="{StaticResource Clementine.StrokeColor}" />

  <!-- Centre -->
  <RadialGradientBrush x:Key="Wheel.Centre" Center="0.5,0.3" GradientOrigin="0.5,0.25" RadiusX="0.75" RadiusY="0.75">
    <GradientStop Offset="0" Color="#FF2A2623" />
    <GradientStop Offset="1" Color="#FF141210" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="Wheel.CentreEdge" Color="#24FFFFFF" />

  <!-- Text -->
  <SolidColorBrush x:Key="Wheel.TextOnAccent" Color="#FF1F140A" />
  <SolidColorBrush x:Key="Wheel.Reason" Color="{StaticResource Clementine.AccentLightColor}" />
  <SolidColorBrush x:Key="Wheel.Hint" Color="#8CF6F2EE" />

  <!-- Type sizes (DIPs) -->
  <sys:Double x:Key="Wheel.LabelSize">13</sys:Double>
  <sys:Double x:Key="Wheel.VariantSize">11.5</sys:Double>
  <sys:Double x:Key="Wheel.GlyphSize">15</sys:Double>
</ResourceDictionary>
