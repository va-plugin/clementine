<!--
  Clementine palette. Shared by the wheel and the shell; both merge this dictionary.
  Only the scaffold owner edits this file - add new resources in your own dictionaries.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Brand -->
  <Color x:Key="Clementine.AccentColor">#FFFF8A1F</Color>
  <Color x:Key="Clementine.AccentLightColor">#FFFFA94D</Color>
  <Color x:Key="Clementine.AccentDeepColor">#FFE8650A</Color>
  <Color x:Key="Clementine.LeafColor">#FF43A047</Color>

  <!-- Dark surfaces (the whole app is dark-themed in v1) -->
  <Color x:Key="Clementine.GlassColor">#EE1B1917</Color>
  <Color x:Key="Clementine.SurfaceColor">#FF1F1D1B</Color>
  <Color x:Key="Clementine.SurfaceRaisedColor">#FF2A2724</Color>
  <Color x:Key="Clementine.SurfaceHoverColor">#FF35312D</Color>
  <Color x:Key="Clementine.StrokeColor">#33FFFFFF</Color>
  <Color x:Key="Clementine.TextColor">#FFF6F2EE</Color>
  <Color x:Key="Clementine.TextSecondaryColor">#FFB5AEA6</Color>
  <Color x:Key="Clementine.TextDisabledColor">#66FFFFFF</Color>
  <Color x:Key="Clementine.SuccessColor">#FF5BC26A</Color>
  <Color x:Key="Clementine.ErrorColor">#FFFF5F56</Color>

  <SolidColorBrush x:Key="Clementine.Accent" Color="{StaticResource Clementine.AccentColor}" />
  <SolidColorBrush x:Key="Clementine.AccentLight" Color="{StaticResource Clementine.AccentLightColor}" />
  <SolidColorBrush x:Key="Clementine.AccentDeep" Color="{StaticResource Clementine.AccentDeepColor}" />
  <SolidColorBrush x:Key="Clementine.Leaf" Color="{StaticResource Clementine.LeafColor}" />
  <SolidColorBrush x:Key="Clementine.Glass" Color="{StaticResource Clementine.GlassColor}" />
  <SolidColorBrush x:Key="Clementine.Surface" Color="{StaticResource Clementine.SurfaceColor}" />
  <SolidColorBrush x:Key="Clementine.SurfaceRaised" Color="{StaticResource Clementine.SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="Clementine.SurfaceHover" Color="{StaticResource Clementine.SurfaceHoverColor}" />
  <SolidColorBrush x:Key="Clementine.Stroke" Color="{StaticResource Clementine.StrokeColor}" />
  <SolidColorBrush x:Key="Clementine.Text" Color="{StaticResource Clementine.TextColor}" />
  <SolidColorBrush x:Key="Clementine.TextSecondary" Color="{StaticResource Clementine.TextSecondaryColor}" />
  <SolidColorBrush x:Key="Clementine.TextDisabled" Color="{StaticResource Clementine.TextDisabledColor}" />
  <SolidColorBrush x:Key="Clementine.Success" Color="{StaticResource Clementine.SuccessColor}" />
  <SolidColorBrush x:Key="Clementine.Error" Color="{StaticResource Clementine.ErrorColor}" />

  <LinearGradientBrush x:Key="Clementine.AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="{StaticResource Clementine.AccentLightColor}" />
    <GradientStop Offset="1" Color="{StaticResource Clementine.AccentDeepColor}" />
  </LinearGradientBrush>

  <!-- Type -->
  <FontFamily x:Key="Clementine.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Clementine.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Clementine.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <sys:Double x:Key="Clementine.CornerRadiusValue">8</sys:Double>
  <CornerRadius x:Key="Clementine.CornerRadius">8</CornerRadius>
</ResourceDictionary>
